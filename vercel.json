{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/client",
  "functions": {"api/index.js": {"maxDuration": 60, "includeFiles": "dist/server/index.js"}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index?__route=:path*"}]
}
